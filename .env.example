# smartLAB — Admin auth environment variables
# Copy this file to .env.local for local development with `vercel dev`,
# and configure the SAME variables in the Vercel project dashboard
# (Settings → Environment Variables) for Production and Preview.

# Admin login email
ADMIN_EMAIL=eng.ahmedabdoualyan@gmail.com

# Admin login password
ADMIN_PASSWORD=fimto@ata

# Secret used to sign admin session tokens.
# MUST be changed to a long random value in production, e.g.:
#   openssl rand -hex 32
AUTH_SECRET=smartlab_demo_secret_6f2c9a14b7d8e3f1

# Session lifetime in hours (default 12)
ADMIN_SESSION_HOURS=12

# ============================================================
# smartLAB Client Portal — Supabase backend
# (Set the SAME values in the Vercel dashboard → Settings →
#  Environment Variables for Production/Preview.)
# ============================================================

# Project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=

# Publishable (anon) key from Supabase → Settings → API Keys
SUPABASE_ANON_KEY=

# Secret service-role key — SERVER-SIDE ONLY, never exposed in client code.
# Restrict it in Supabase dashboard (Supavisor: service_role) as needed.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the portal (used in notification messages)
CLIENT_PORTAL_URL=https://smartlab.vercel.app/client/portal.html

# ============================================================
# Notifications — Twilio (WhatsApp/SMS) — OPTIONAL during scaffolding
# If none of these are set, dispatches are recorded as "dry_run" rows.
# ============================================================

# Account SID + auth token from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The Twilio number sending the message (e.g. +15551234567,
# or whatsapp:+15551234567 when using WhatsApp)
TWILIO_PHONE=

# Set to "true" to deliver via WhatsApp instead of SMS
TWILIO_USE_WHATSAPP=false

# Alternative generic webhook URL (receives a JSON POST) if you don't use Twilio
WHATSAPP_WEBHOOK_URL=
