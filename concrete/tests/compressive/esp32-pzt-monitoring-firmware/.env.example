# ═══════════════════════════════════════════════════════════════════
#  smartLAB — InfluxDB 3 Cloud Serverless
#  Copy to `.env.local` (git-ignored) and fill in real values.
# ═══════════════════════════════════════════════════════════════════
#
#  ⚠  RULE 1 — NEVER prefix any of these with VITE_
#     Vite inlines every VITE_* variable into the public browser
#     bundle. This project builds to ONE public index.html, so a
#     VITE_-prefixed token is readable by every visitor via View Source.
#     These are read ONLY by the serverless function in /api.
#
#  ⚠  RULE 2 — TWO SEPARATE TOKENS, never one All-Access token
#     An All-Access token can delete your entire bucket. Split it:
#       esp32-write     → Write scope on pzt_sensor_data  → flashed to the board
#       dashboard-read  → Read  scope on pzt_sensor_data  → set here on Vercel
#     Create both in: InfluxDB Cloud → Load Data → API Tokens → Generate
#
# ═══════════════════════════════════════════════════════════════════


# ── 1 · HOST (region URL) ─────────────────────────────────────────
#
#  ⚠  https://influxdata.com is the MARKETING WEBSITE. It resolves,
#     serves HTML, and will never accept a read or a write. Posting
#     there returns 404/405 and the board logs a silent failure.
#
#  Your real host is region-scoped. Find it in the InfluxDB Cloud UI:
#  top-right org menu → the value shown in the browser address bar.
#
#     US East (Virginia)  https://us-east-1-1.aws.cloud2.influxdata.com
#     EU (Frankfurt)      https://eu-central-1-1.aws.cloud2.influxdata.com
#
INFLUX_HOST=https://us-east-1-1.aws.cloud2.influxdata.com


# ── 2 · DATABASE / BUCKET ─────────────────────────────────────────
INFLUX_DATABASE=pzt_sensor_data


# ── 3 · READ-ONLY TOKEN (dashboard side) ──────────────────────────
#  Scope: Read on pzt_sensor_data ONLY.
#  This is consumed by /api/influx-query.ts via process.env and is
#  never serialised into any response body.
INFLUX_TOKEN=paste_your_dashboard-read_token_here


# ── 4 · CORS ALLOW-LIST ───────────────────────────────────────────
#  Comma-separated origins permitted to call the proxy.
#  Lock this to your real domain before going to production —
#  leaving localhost in a production deployment lets any local
#  script on a visitor's machine query your bucket.
INFLUX_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app


# ═══════════════════════════════════════════════════════════════════
#  FIRMWARE CONSTANTS  (src/firmware.ts §14 — NOT read from this file)
# ═══════════════════════════════════════════════════════════════════
#  These are compiled into the ESP32 binary. Listed here so the whole
#  deployment contract lives in one document.
#
#    INFLUX_HOST   = "us-east-1-1.aws.cloud2.influxdata.com"
#                    ↑ no https:// prefix, no trailing slash
#    INFLUX_ORG    = "saudi"
#    INFLUX_BUCKET = "pzt_sensor_data"
#    INFLUX_TOKEN  = "<esp32-write token>"     ← WRITE scope only
#
#  Assume the firmware token is public: anyone holding the board can
#  dump flash and read it. Write-only scope means a leak costs you
#  junk rows, not the loss of the bucket.
#
#  Write endpoint used by the board (InfluxDB 3 keeps the v2 route):
#    POST https://<HOST>/api/v2/write
#         ?org=<ORG>&bucket=<BUCKET>&precision=ns
#    Authorization: Token <esp32-write>
#    Content-Type:  text/plain; charset=utf-8
#    Success:       HTTP 204 No Content
#
#  Common failures:
#    401  bad or missing token
#    404  wrong host (usually plain influxdata.com) or wrong bucket
#    422  malformed line protocol — nearly always a NaN in a field
#
#
#  ── LINE PROTOCOL SCHEMA ─────────────────────────────────────────
#  measurement : emi_sweep
#  tags        : session_id, specimen_id, badge
#  fields      : freq_khz, conductance_us, resistance_kohm, voltage_mv,
#                res_freq_khz, damage_rmsd, temp_c, hydration_pct,
#                test_age_days, calculated_strength_mpa, sweep_id
#  timestamp   : nanoseconds, NTP-synchronised
#
#  test_age_days           fractional days since cast, so 4 h and 8 h
#                          early-age tests keep sub-day resolution
#  calculated_strength_mpa on-device estimate: conductance feed-forward
#                          blended with Plowman fc(t)=A·ln(t)+B
#
#
#  ── FIELD PROCEDURE ──────────────────────────────────────────────
#  1. Flash the firmware with the esp32-write token and region host
#  2. Pour the specimen, embed the PZT patch, power the node
#  3. Wait for the serial line: [influx] NTP locked — epoch ...
#     (writes are refused until this appears; an ESP32 boots at
#      epoch 0 and unsynced points land in 1970, silently poisoning
#      every time-range query afterwards)
#  4. Press 'c' once on the serial console to stamp the cast time
#     into NVS. It survives reboots.
#  5. Sweeps now carry a true test_age_days and a strength estimate
#     anchored to it.
#
#  Serial commands:  c = stamp cast date · r = clear crush latch
#                    b = re-capture baseline · i = print node identity
